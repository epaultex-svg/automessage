{
  "name": "automessage",
  "version": "0.1.0",
  "description": "Chrome extension: AI reply suggestions for Gmail via OpenRouter",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/make-icons.js",
    "build": "webpack --mode production",
    "build:zip": "npm run build && zip -r automessage.zip manifest.json dist/ popup/popup.html styles/ icons/",
    "test:model-contract": "node scripts/check-model-contract.js",
    "watch": "webpack --mode development --watch",
    "dev": "webpack --mode development"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "dotenv": "^17.4.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
