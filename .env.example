# Copy this file to .env and fill in your proxy details.
# These values are injected into the extension bundle at build time and never committed to git.
#
# 1. Deploy the Cloudflare Worker in server/ first (see README.md for steps).
# 2. Paste the *.workers.dev URL below.
# 3. Paste the shared token you generated with: openssl rand -hex 32

# URL of your deployed Cloudflare Worker (no trailing slash)
AUTOMESSAGE_PROXY_URL=https://automessage-proxy.YOUR_SUBDOMAIN.workers.dev

# Shared secret set on the Worker via: wrangler secret put AUTOMESSAGE_SHARED_TOKEN
AUTOMESSAGE_SHARED_TOKEN=replace-me-with-output-of-openssl-rand-hex-32
